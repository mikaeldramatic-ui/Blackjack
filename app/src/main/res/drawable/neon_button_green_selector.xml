<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State -->

    <item android:state_pressed="true">
    <shape android:shape="rectangle">
        <solid android:color="#008033"/> <!-- Dark Green -->
        <corners android:radius="14dp" />
        <stroke android:width="3dp" android:color="#00FF99" /> <!-- Neon border -->
        <padding android:left ="14dp" android:top="10dp"
            android:right="14dp" android:bottom="10dp"/>


    </shape>
    </item>

    <!-- Default State -->

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00CC66"/>
            <corners android:radius="12dp"/>
                <stroke android:width="4dp" android:color="#00FFAA"/>
            <padding android:left="12dp" android:top="8dp"
                android:right="12dp" android:bottom="8dp"/>
        </shape>
    </item>

</selector>


<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State -->

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#800000"/> <!-- Dark Red -->
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FF5555" /> <!-- Neon border -->
            <padding android:left ="14dp" android:top="8dp"
                android:right="14dp" android:bottom="8dp"/>


        </shape>
    </item>

    <!-- Default State -->

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0000"/>
            <corners android:radius="14dp"/>
            <stroke android:width="4dp" android:color="#FF7777"/>
            <padding android:left="14dp" android:top="10dp"
                android:right="14dp" android:bottom="10dp"/>
        </shape>
    </item>

</selector>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_board">

    <!-- Win Title -->

    <TextView
        android:id="@+id/txtWinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOU WIN!"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:shadowRadius="8"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Score -->
    <TextView
        android:id="@+id/txtScoreInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player:  0    Dealer:  0"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtWinTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Play Again -->

    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="Play Again"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:background="@drawable/neon_button_selector"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toBottomOf="@id/txtWinTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



    <!-- Back to menu -->
    <Button
        android:id="@+id/btnWinBackMenu"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="Main Menu"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:background="@drawable/neon_button_selector"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnPlayAgain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
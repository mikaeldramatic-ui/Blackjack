<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/game_board"
    tools:context=".GameBoardActivity">

    <!-- Quit Button -->
    <ImageButton
        android:id="@+id/btnQuit"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/neon_button_red_selector"
        android:src="@drawable/ic_close"
        android:contentDescription="Quit Game"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================== DEALER ===================== -->

    <!-- Dealer Score -->
    <TextView
        android:id="@+id/dealerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dealer: 0"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnQuit"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Dealer Cards (visible + hidden card_back added dynamically) -->
    <LinearLayout
        android:id="@+id/dealerCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/dealerScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================== PLAYER MONEY & MAIN SCORE ===================== -->

    <TextView
        android:id="@+id/playerMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Money: $200"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/dealerCards"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/playerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player: 0"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/playerMoney"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================== MAIN HAND ===================== -->

    <LinearLayout
        android:id="@+id/playerCards"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/playerScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================== SPLIT HAND 1 ===================== -->

    <LinearLayout
        android:id="@+id/playerHand1"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/playerCards"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/playerHand1Score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hand1: 0"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/playerHand1"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ===================== SPLIT HAND 2 ===================== -->

    <LinearLayout
        android:id="@+id/playerHand2"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/playerHand1Score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/playerHand2Score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hand2: 0"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/playerHand2"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ===================== ACTION BUTTONS ===================== -->

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnHit"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="HIT"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:background="@drawable/neon_button_green_selector"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btnStand"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="STAND"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:background="@drawable/neon_button_red_selector"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btnSplit"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:text="SPLIT"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:background="@drawable/neon_button_green_selector"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ===================== WIN OVERLAY ===================== -->

    <FrameLayout
        android:id="@+id/winOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0"
        android:background="#AA000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOU WIN!"
            android:textColor="@android:color/holo_green_light"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/winAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0"
            android:textColor="@android:color/holo_green_light"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="120dp"/>

        <TextView
            android:id="@+id/winTotalMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Money: $0"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="40dp"/>
    </FrameLayout>

    <!-- ===================== LOSE OVERLAY ===================== -->

    <FrameLayout
        android:id="@+id/loseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0"
        android:background="#AA000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOU LOST!"
            android:textColor="@android:color/holo_red_light"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/loseAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-0"
            android:textColor="@android:color/holo_red_light"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="120dp"/>

        <TextView
            android:id="@+id/loseTotalMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Money: $0"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="40dp"/>
    </FrameLayout>

    <!-- ===================== PUSH OVERLAY ===================== -->

    <FrameLayout
        android:id="@+id/pushOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0"
        android:background="#AA000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PUSH"
            android:textColor="@android:color/holo_blue_light"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/pushTotalMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Money: $0"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="40dp"/>
    </FrameLayout>

    <!-- ===================== BLACKJACK OVERLAY ===================== -->

    <FrameLayout
        android:id="@+id/blackjackOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0"
        android:background="#AA000000">

        <TextView
            android:id="@+id/blackjackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLACKJACK!"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/blackjackAmountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="120dp"/>

        <TextView
            android:id="@+id/blackjackTotalMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Money: $0"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="40dp"/>
    </FrameLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
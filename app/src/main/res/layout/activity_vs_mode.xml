<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vs_game"

    tools:context=".VsModeActivity">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBackVsMode"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/neon_button_selector"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="20dp"
        app:tint="#AAFF00FF" />


    <!-- Title -->
    <TextView
        android:id="@+id/vsModeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VS Mode"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- How Many players text-->

    <TextView
        android:id="@+id/txtHowManyPlayers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How Many Players?"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="200dp" />

    <!-- Button Minus -->
    <ImageButton
        android:id="@+id/btnMinus"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/neon_button_selector"
        android:src="@android:drawable/ic_input_delete"
        android:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHowManyPlayers" />

    <!-- Player Count -->

    <TextView
        android:id="@+id/txtPlayerCount"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="1"
        android:textColor="@android:color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtHowManyPlayers"
        app:layout_constraintStart_toEndOf="@id/btnMinus"
        app:layout_constraintEnd_toStartOf="@id/btnPlus"
        android:layout_marginTop="40dp"/>

    <!-- Button Plus -->

    <ImageButton
        android:id="@+id/btnPlus"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/neon_button_selector"
        android:src="@android:drawable/ic_media_next"
        android:tint="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/txtHowManyPlayers"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="80dp"/>



    <!-- Placeholder -->

    <Button
        android:id="@+id/btnStartVs"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="Start Match"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:background="@drawable/neon_button_selector"
        android:layout_marginTop="250dp"
        app:layout_constraintTop_toBottomOf="@+id/vsModeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>